# --- Database ---
# Production / Render / Neon / Supabase:
DATABASE_URL=postgres://user:password@host:5432/datapay
# Local demo without installing PostgreSQL (embedded database stored in ./.pgdata):
# DATABASE_URL=pglite://./.pgdata

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# Google sign-in (optional; button is hidden when unset). Only pre-created users may sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- First admin: pass these on the command line for `npm run db:seed:admin` (do not store a real password in a file) ---
# ADMIN_EMAIL=you@yourcompany.com
# ADMIN_PASSWORD=a-long-unique-password
# ADMIN_NAME=Your Name

# --- Optional ---
# Max DB connections per server instance (keep small on serverless; use your provider's pooled URL)
DB_POOL_MAX=5

# TDS withheld from every contributor's earnings, in percent (default 10). Frozen on each payment statement when it is created.
# TDS_PERCENT=10
# Company name printed on payment acknowledgement slips
# COMPANY_NAME=DataPay
